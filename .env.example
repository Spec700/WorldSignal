# Docker Compose can start without a .env file, but FlightSignal requires the
# AirLabs key below before it can resolve or monitor flights.
#
# When migrating an existing CredSignal database into the Docker-only stack,
# copy this file to `.env` and restore the exact key that encrypted that data.
# Generate a key only for a new host-native installation with:
# openssl rand -base64 32
CREDSIGNAL_DATA_KEY=replace-with-a-base64-encoded-32-byte-key
CREDSIGNAL_KEY_VERSION=docker-local-v1
CREDSIGNAL_WORKSPACE_SLUG=local

# FlightSignal uses AirLabs. The key remains server-side and is never exposed to
# browser code. Free accounts currently include a limited monthly request budget.
AIRLABS_API_KEY=

# This controls how often the worker checks the local database for due flights.
# It does not control AirLabs request frequency; each flight stores its own next
# provider check according to the quota-aware schedule.
FLIGHTSIGNAL_POLL_INTERVAL_MS=30000
