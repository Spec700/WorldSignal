# Local PostgreSQL started by `docker compose up -d postgres`.
DATABASE_URL=postgresql://priority_signals:priority_signals_dev@127.0.0.1:5432/priority_signals

# Required for reversible CredSignal secret storage. Generate a 32-byte key with:
# openssl rand -base64 32
CREDSIGNAL_DATA_KEY=replace-with-a-base64-encoded-32-byte-key
CREDSIGNAL_KEY_VERSION=local-v1
CREDSIGNAL_WORKSPACE_SLUG=local
